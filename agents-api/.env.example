# OpenAI API key for LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# MongoDB for compounds, units, developers
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/semsai

# Session storage (optional)
# auto: use Redis when available, otherwise in-memory fallback
SESSION_BACKEND=auto
REDIS_URL=redis://localhost:6379
